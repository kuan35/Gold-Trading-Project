{
  "name": "gold-trading-terminal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build --emptyOutDir false",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "build:pages": "tsc -b && vite build --mode pages --emptyOutDir false"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "lightweight-charts": "^5.0.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
