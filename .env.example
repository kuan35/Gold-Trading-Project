# Backend-only variables; this example is NOT loaded automatically.
# Never put credentials in VITE_ variables, frontend, GitHub or reports.
GOLD_ENABLE_LLM=false
GOLD_LLM_PROVIDER=openai_compatible
GOLD_LLM_API_KEY=
GOLD_LLM_BASE_URL=https://api.groq.com/openai/v1
GOLD_LLM_MODEL=openai/gpt-oss-120b
GOLD_LLM_TOKEN_FIELD=max_completion_tokens
GOLD_LLM_MAX_TOKENS=2048
GOLD_LLM_REASONING_EFFORT=low
GOLD_LLM_TIMEOUT_SECONDS=40
# Free plan has independent request and token limits; 429 falls back to a local summary.
# Omit GOLD_LLM_REASONING_EFFORT for providers that do not support it.
# Broker and live market connections are separate.

# Local official Claude Code adapter (requires your own official CLI login).
# Set GOLD_LLM_PROVIDER=claude_code to use these instead of the HTTP provider.
GOLD_CLAUDE_MODEL=sonnet
GOLD_CLAUDE_EFFORT=medium
GOLD_CLAUDE_TIMEOUT_SECONDS=120
# Optional absolute path to official claude.exe or npm claude.cmd / claude.ps1.
GOLD_CLAUDE_EXECUTABLE=
# Text only; no image upload, file access, shell, or broker tools.
