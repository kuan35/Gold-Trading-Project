# Separate LIVE account, read-only by default. Never paste secrets in chat or commit this file filled.
# Copy locally to .env.ctrader.live and fill it yourself; no DEMO credentials are inherited.
CTRADER_ENVIRONMENT=live
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
# Required explicit Open API account ID (not display login number).
CTRADER_ACCOUNT_ID=
# LIVE write remains off unless this exact local value is YES and both caps are positive.
# Only use a cTrader access token with trading scope when you intentionally enable writes.
CTRADER_LIVE_TRADING_ENABLED=NO
# Maximum estimated USD loss from the stop loss on one new LIVE gold order.
GOLD_LIVE_MAX_ORDER_STOP_USD=
# Maximum combined XAUUSD open positions plus pending orders after one new order.
GOLD_LIVE_MAX_GROSS_LOTS=
