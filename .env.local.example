# This file is loaded by start-local.ps1 / start-local.sh only.
# Your own official CLI login is used; do not paste authentication tokens here.
GOLD_ENABLE_LLM=true
GOLD_LLM_PROVIDER=program
GOLD_CLAUDE_MODEL=sonnet
GOLD_CLAUDE_EFFORT=medium
GOLD_CLAUDE_TIMEOUT_SECONDS=120
GOLD_CODEX_TIMEOUT_SECONDS=120
# Optional absolute official executable paths when not on PATH.
GOLD_CLAUDE_EXECUTABLE=
GOLD_CODEX_EXECUTABLE=
# SL/TP margin ROI fallback assumption; set to your own account leverage.
# Broker expected margin takes priority for market orders when available in USD.
# This is not verified symbol leverage. Restart after changing this file.
GOLD_PREVIEW_LEVERAGE=200
# Optional pre-trade comparison assumptions. Each is round-trip USD per ounce.
# Set all six explicitly. The stress total must be greater than the baseline total.
# GOLD_ADVICE_BASELINE_SPREAD_USD_PER_OZ=
# GOLD_ADVICE_BASELINE_COMMISSION_USD_PER_OZ=
# GOLD_ADVICE_BASELINE_SLIPPAGE_USD_PER_OZ=
# GOLD_ADVICE_STRESS_SPREAD_USD_PER_OZ=
# GOLD_ADVICE_STRESS_COMMISSION_USD_PER_OZ=
# GOLD_ADVICE_STRESS_SLIPPAGE_USD_PER_OZ=
